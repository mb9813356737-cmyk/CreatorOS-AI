// CreatorOS AI — Prisma Schema
// Production-grade PostgreSQL schema with proper indexing and relations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── User Model ──────────────────────────────────────────────
model User {
  id                     String             @id @default(cuid())
  clerkId                String?            @unique @map("clerk_id")
  email                  String             @unique
  name                   String?
  imageUrl               String?            @map("image_url")
  plan                   Plan               @default(FREE)
  role                   Role               @default(USER)
  banned                 Boolean            @default(false)
  suspendedUntil         DateTime?          @map("suspended_until")
  emailVerified          Boolean            @default(false) @map("email_verified")
  emailVerificationToken String?            @unique @map("email_verification_token")
  emailVerificationExpires DateTime?         @map("email_verification_expires")
  razorpayCustomerId     String?            @unique @map("razorpay_customer_id")
  razorpaySubscriptionId String?            @map("razorpay_subscription_id")
  stripeCustomerId       String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?            @unique @map("stripe_subscription_id")
  subscriptionStatus     SubscriptionStatus @default(INACTIVE) @map("subscription_status")
  subscriptionEnd        DateTime?          @map("subscription_end")
  monthlyCredits         Int                @default(10) @map("monthly_credits")
  creditsUsed            Int                @default(0) @map("credits_used")
  creditsResetAt         DateTime?          @map("credits_reset_at")
  niche                  String?
  platform               String?
  password               String?
  passwordResetToken     String?            @unique @map("password_reset_token")
  passwordResetExpires   DateTime?          @map("password_reset_expires")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  generations Generation[]
  payments    Payment[]
  tickets     Ticket[]
  auditLogs   AuditLog[]
  queueJobs   AIQueueJob[]
  analytics   AIUsageAnalytics[]

  @@index([email])
  @@index([plan])
  @@map("users")
}

// ─── Generation Model ────────────────────────────────────────
model Generation {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       GenerationType
  input      Json
  output     String         @db.Text
  viralScore Float?         @map("viral_score")
  tokens     Int            @default(0)
  platform   String?
  language   String?        @default("en")
  isFavorite Boolean        @default(false) @map("is_favorite")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([userId, isFavorite])
  @@map("generations")
}

// ─── Payment Model ───────────────────────────────────────────
model Payment {
  id                     String        @id @default(cuid())
  userId                 String        @map("user_id")
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayPaymentId      String?       @unique @map("razorpay_payment_id")
  razorpayOrderId        String?       @map("razorpay_order_id")
  razorpaySubscriptionId String?       @map("razorpay_subscription_id")
  razorpaySignature      String?       @map("razorpay_signature")
  stripePaymentId        String?       @unique @map("stripe_payment_id")
  stripeSubscriptionId   String?       @map("stripe_subscription_id")
  stripeInvoiceId        String?       @unique @map("stripe_invoice_id")
  amount                 Int           // Amount in paise (₹499 = 49900)
  currency               String        @default("INR")
  status                 PaymentStatus @default(PENDING)
  plan                   Plan
  billingPeriod          String?       @map("billing_period") // "monthly" | "yearly"
  metadata               Json?
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@index([stripeSubscriptionId])
  @@map("payments")
}

// ─── Enums ───────────────────────────────────────────────────
enum Plan {
  FREE
  PRO
  AGENCY
}

enum Role {
  USER
  SUPER_ADMIN
  MODERATOR
  SUPPORT_AGENT
  ANALYST
  FINANCE_ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum GenerationType {
  VIRAL_HOOK
  CAPTION
  SCRIPT
  THUMBNAIL
  TREND
  VIRAL_SCORE
  REPURPOSE
}

// ─── Support Ticket Model ────────────────────────────────────
model Ticket {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  message      String   @db.Text
  status       String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  priority     String   @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  assignedTo   String?  @map("assigned_to")
  internalNote String?  @map("internal_note") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tickets")
}

// ─── Audit Log Model ─────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminEmail String   @map("admin_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}

// ─── Feature Flag Model ──────────────────────────────────────
model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  rolloutPct  Int      @default(100) @map("rollout_pct") // 0-100 for canary rollout
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ─── Asynchronous Queue Jobs ────────────────────────────────
model AIQueueJob {
  id                 String   @id @default(cuid())
  jobId              String   @unique @map("job_id")
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  status             String   @default("pending")
  payload            Json
  result             String?  @db.Text
  error              String?  @db.Text
  retryCount         Int      @default(0) @map("retry_count")
  maxRetries         Int      @default(3) @map("max_retries")
  fallbackTriggered  Boolean  @default(false) @map("fallback_triggered")
  workerId           String?  @map("worker_id")
  executionTimeMs    Int      @default(0) @map("execution_time_ms")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("ai_queue_jobs")
}

// ─── Usage Cost & Token Analytics ───────────────────────────
model AIUsageAnalytics {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId      String?  @map("generation_id")
  promptTokens      Int      @default(0) @map("prompt_tokens")
  completionTokens  Int      @default(0) @map("completion_tokens")
  totalTokens       Int      @default(0) @map("total_tokens")
  providerCost      Float    @default(0.0) @map("provider_cost")
  estimatedProfit   Float    @default(0.0) @map("estimated_profit")
  providerUsed      String   @map("provider_used")
  modelUsed         String   @map("model_used")
  responseTimeMs    Int      @map("response_time_ms")
  cacheHit          Boolean  @default(false) @map("cache_hit")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([providerUsed])
  @@map("ai_usage_analytics")
}

// ─── Provider Health Telemetry ──────────────────────────────
model ProviderHealth {
  id              String   @id @default(cuid())
  provider        String   @unique
  isUp            Boolean  @default(true) @map("is_up")
  errorCount      Int      @default(0) @map("error_count")
  averageLatency  Int      @default(0) @map("average_latency_ms")
  uptimePercentage Float    @default(100.0) @map("uptime_percentage")
  lastCheckedAt   DateTime @default(now()) @map("last_checked_at")

  @@map("provider_health")
}

// ─── Global Financial Telemetry ─────────────────────────────
model CostTelemetry {
  id            String   @id @default(cuid())
  date          DateTime @unique @default(now()) @db.Date
  totalCost     Float    @default(0.0) @map("total_cost")
  totalRevenue  Float    @default(0.0) @map("total_revenue")
  netProfit     Float    @default(0.0) @map("net_profit")
  tokensCount   Int      @default(0) @map("tokens_count")
  requestsCount Int      @default(0) @map("requests_count")

  @@map("cost_telemetry")
}

// ─── Dynamic Feature Toggles ────────────────────────────────
model FeatureToggle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_toggles")
}
